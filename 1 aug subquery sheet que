use newdb;
CREATE TABLE CUSTOMERS (
CUSTOMER_ID VARCHAR(10) NOT NULL,
CUSTOMER_NAME VARCHAR(100) NOT NULL,
CITY VARCHAR(100) NOT NULL,
CREDIT_LIMIT DECIMAL(10,2) NOT NULL,
PRIMARY KEY (CUSTOMER_ID)
);
